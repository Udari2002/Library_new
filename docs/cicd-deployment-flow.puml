@startuml CI/CD Pipeline Deployment Flow

!theme plain
title Library Management System - CI/CD Pipeline & Deployment Architecture

' Define colors
!define LIGHTBLUE #E8F4FD
!define LIGHTGREEN #E8F6E8
!define LIGHTYELLOW #FFF9E6
!define LIGHTPINK #FFE6E6
!define LIGHTGRAY #F5F5F5
!define LIGHTORANGE #FFE6CC

package "Development Environment" as dev LIGHTBLUE {
  [Developer] as developer
  [Git Repository] as git
  [GitHub] as github
  
  developer --> git : Code Changes
  git --> github : Push to main branch
}

package "CI/CD Platform" as cicd LIGHTGREEN {
  [Jenkins Server] as jenkins
  [Build Agents] as agents
  [Docker] as docker_build
  
  github --> jenkins : Webhook Trigger
  jenkins --> agents : Execute Pipeline
  agents --> docker_build : Build Images
}

package "Container Registry" as registry LIGHTYELLOW {
  [DockerHub] as dockerhub
  [Backend Image] as backend_image
  [Frontend Image] as frontend_image
  
  docker_build --> dockerhub : Push Images
  dockerhub --> backend_image : library-backend:latest
  dockerhub --> frontend_image : library-frontend:latest
}

package "Infrastructure as Code" as iac LIGHTPINK {
  [Terraform] as terraform
  [AWS Provider] as aws_provider
  [Infrastructure State] as tf_state
  
  jenkins --> terraform : Provision Infrastructure
  terraform --> aws_provider : Create Resources
  terraform --> tf_state : State Management
}

package "AWS Cloud Infrastructure" as aws LIGHTORANGE {
  [VPC] as vpc
  [Internet Gateway] as igw
  [Security Groups] as sg
  [EC2 Instance] as ec2
  [Elastic IP] as eip
  
  vpc --> igw : Internet Access
  vpc --> sg : Network Security
  sg --> ec2 : Instance Protection
  ec2 --> eip : Static IP Address
}

package "Configuration Management" as config LIGHTGRAY {
  [Ansible] as ansible
  [Playbooks] as playbooks
  [Inventory] as inventory
  
  jenkins --> ansible : Deploy Application
  ansible --> playbooks : Execute Tasks
  ansible --> inventory : Target Servers
}

package "Production Environment" as prod LIGHTBLUE {
  [Docker Compose] as compose
  [MongoDB Container] as mongo_container
  [Backend Container] as backend_container
  [Frontend Container] as frontend_container
  [NGINX] as nginx_prod
  
  compose --> mongo_container : Database Service
  compose --> backend_container : API Service
  compose --> frontend_container : Web Service
  frontend_container --> nginx_prod : Static Files
}

' Pipeline Flow
jenkins --> terraform : "1. Infrastructure\nProvisioning"
terraform --> ec2 : Create AWS Resources
jenkins --> dockerhub : "2. Build & Push\nDocker Images"
jenkins --> ansible : "3. Deploy\nApplication"
ansible --> ec2 : SSH Connection
ansible --> compose : Deploy Containers
compose --> dockerhub : Pull Images

' Service Connections
backend_container --> mongo_container : Database Connection\n(Port 27017)
nginx_prod --> backend_container : API Proxy\n(Port 5001)
frontend_container --> nginx_prod : Serve Static Files\n(Port 3000)

' External Access
cloud "Internet" as internet
internet --> eip : Static IP Access\n(44.198.192.218)
eip --> nginx_prod : Web Traffic

note right of jenkins
  **Pipeline Stages:**
  1. Checkout Code
  2. Build Docker Images
  3. Push to DockerHub
  4. Provision Infrastructure
  5. Deploy with Ansible
  6. Health Checks
end note

note right of ec2
  **AWS Resources:**
  - t3.micro EC2 Instance
  - Elastic IP Address
  - Security Groups
  - VPC with Internet Gateway
  - SSH Key Pair
end note

note right of compose
  **Deployment:**
  - Multi-container setup
  - Environment variables
  - Volume persistence
  - Service networking
  - Health monitoring
end note

@enduml